{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telerich",
  "main": "worker/worker.js",
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "telerich.config7x.dpdns.org", "custom_domain": true }
  ],
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    { "binding": "RICHKV", "id": "d80f9758b59542a3a3a4e930dd60b5a7" }
  ],
  "vars": {
    "FREE_LIMIT": "10",
    "REF_BONUS": "10",
    "QUOTA_EXEMPT": "7886358210",
    "PUBLIC_URL": "",
    "PREMIUM_EMOJI": "1",
    // Forced join: comma-separated @username or -100… IDs at start; the owner
    // can extend or replace this list from chat with /join (stored in KV).
    "JOIN_CHANNEL": "@Config7x",
    // Forced join manager: one chat is free, more needs a one-time Stars purchase.
    "JOIN_PRO_STARS": "250",
    "JOIN_PRO_LIMIT": "5"
  }
}
